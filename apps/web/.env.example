# Base URL of the Laravel API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Show the "Continue with X" social login button.
NEXT_PUBLIC_ENABLE_X=false

# Laravel Reverb (realtime) — leave blank to disable realtime entirely.
# Realtime is enhancement-only; the app is fully functional without it.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
# ws | wss — forceTLS is enabled when this is "https".
NEXT_PUBLIC_REVERB_SCHEME=http
