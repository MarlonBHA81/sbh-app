APP_NAME="SBH Community"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# AI gateway. 'null' disables all AI features (default). Set to 'anthropic'
# and provide an API key to enable moderation assists and topic suggestions.
AI_DRIVER=null
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Open tender ingestion (OpenProcurement-compatible API). Off by default; enable
# and point the base URL at a South-African OpenProcurement endpoint for SA
# tenders (the default serves the public standard data). Also configurable from
# the super-admin Integrations page. Runs hourly via `tenders:sync`.
OPENPROCUREMENT_ENABLED=false
OPENPROCUREMENT_BASE_URL=https://public.api.openprocurement.org
OPENPROCUREMENT_VERSION=2.5
OPENPROCUREMENT_SOURCE=OpenProcurement
# OPENPROCUREMENT_AUTH=user:pass
OPENPROCUREMENT_PAGE_LIMIT=200
OPENPROCUREMENT_PUBLISH=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Comma-separated channels the stack writes to. Add "json" for structured
# one-JSON-object-per-line logs to stderr (container log shippers), e.g.
# LOG_STACK=single,json
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Observability (see docs/observability.md). All off by default.
# Sentry error tracking — blank disables reporting. Also settable in Integrations.
SENTRY_LARAVEL_DSN=
# Fraction of transactions traced (0 = errors only, preserves free-tier quota).
SENTRY_TRACES_SAMPLE_RATE=0
# Alert triage: where signed alerts POSTed to /api/v1/observability/alert are filed.
# null = log only; github = open a de-duplicated GitHub issue a fix-agent can act on.
OBSERVABILITY_ISSUE_DRIVER=null
# HMAC-SHA256 shared secret the monitor signs the alert body with. Blank rejects all.
OBSERVABILITY_ALERT_SECRET=
# GitHub credentials for the "github" driver (fine-grained PAT, Issues: read & write).
GITHUB_TOKEN=
GITHUB_REPO=

# ClamAV upload virus scanning (off by default). Enable with the `av` compose
# profile in production. To scan media larger than 25 MiB, raise both
# CLAMAV_MAX_BYTES and clamd's StreamMaxLength together.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_MAX_BYTES=26214400
# false = let an upload through if the scanner can't be reached (logged);
# true = reject it.
CLAMAV_FAIL_CLOSED=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Media storage disks. Defaults preserve local storage: public media on the
# 'public' disk, private deliverables/upload chunks on 'local'. Set both to 's3'
# (configured in config/filesystems.php via the AWS_* vars below) to move media
# to object storage with no code changes.
# MEDIA_PUBLIC_DISK=public
# MEDIA_PRIVATE_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

MEDIA_WEBP_QUALITY=82
MEDIA_MAX_WIDTH=1920

# Web push (php artisan webpush:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Marketplace payments (also configurable from the admin Integrations page)
# PAYMENTS_DRIVER: null (disabled) | payfast
PAYMENTS_DRIVER=null
PLATFORM_FEE_PERCENT=10
# PayFast sandbox test credentials: merchant 10000100 / key 46f0cd694581a
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Live streaming (RTMP -> HLS) for masterclass rooms
# STREAM_DRIVER: null (disabled) | mux
STREAM_DRIVER=null
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Deep health-check thresholds (scheduled system:health warns past these).
HEALTH_FAILED_JOBS_THRESHOLD=25
HEALTH_QUEUE_BACKLOG_THRESHOLD=1000
