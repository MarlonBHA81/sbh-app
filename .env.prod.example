# Copy to .env.prod and fill in before running docker-compose.prod.yml.
# This file is loaded by the `api` container (Laravel) and compose itself.

APP_NAME="SBH Community"
APP_ENV=production
APP_KEY= # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://example.com
FRONTEND_URL=https://example.com
SANCTUM_STATEFUL_DOMAINS=example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sbh
DB_USERNAME=sbh
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

REDIS_HOST=redis
# Set to a random string to require Redis auth (deploy-vps.sh generates one).
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=.example.com

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sbh
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
# Public hostname browsers connect to for websockets (nginx :8080 ssl)
REVERB_PUBLIC_HOST=example.com

# Media: local (default), s3, or r2-compatible endpoint
FILESYSTEM_DISK=local
# Storage disks for media. Defaults: public media -> 'public', private
# deliverables/upload chunks -> 'local'. Set both to 's3' (see AWS_* / S3 vars)
# to serve media from object storage without code changes.
# MEDIA_PUBLIC_DISK=public
# MEDIA_PRIVATE_DISK=local
MEDIA_MAX_WIDTH=1920
MEDIA_WEBP_QUALITY=82

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com

# Social login (leave blank to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# X/Twitter requires a paid API tier; fill to enable
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Web push (php artisan webpush:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# ClamAV upload virus scanning (opt-in; start the `av` compose profile too)
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=false
